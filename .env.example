# ───────── Site ─────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_WHATSAPP_NUMBER=923488317780
NEXT_PUBLIC_CONTACT_EMAIL=makhdoomfragrances@gmail.com

# Social profiles are managed by the owner in the dashboard (Admin -> "Social links"). These three are OPTIONAL
# fallbacks that are used only until a link is saved there. Leave them commented out unless you want a fallback.
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your_handle
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/your_page
# NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@your_handle

# Delivery rules (shown in the cart, re-calculated on the server). Confirm with the owner.
NEXT_PUBLIC_SHIPPING_FEE=250
NEXT_PUBLIC_FREE_SHIPPING_OVER=4000

# ───────── Supabase (Project Settings → API) ─────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — never expose

# ───────── Email via Resend (resend.com) ─────────
RESEND_API_KEY=
# Until you verify a domain in Resend you can only send FROM onboarding@resend.dev and only TO the Resend account email.
RESEND_FROM="Makhdoom Fragrances <onboarding@resend.dev>"
ORDER_NOTIFY_EMAIL=makhdoomfragrances@gmail.com
# Set to true only after verifying a sending domain; emails a receipt to customers who typed an email.
SEND_CUSTOMER_CONFIRMATION=false

# ───────── Admin panel (/admin) ─────────
# In production the admin stays DISABLED (and says why on /admin/login) unless both are strong:
ADMIN_PASSWORD=                       # 12+ characters, a long passphrase
ADMIN_SESSION_SECRET=                 # 32+ random chars: openssl rand -hex 32
# ADMIN_SESSION_EPOCH=2               # optional: change this value to sign every admin session out instantly

# ───────── Optional hardening / ops ─────────
# Rate limiting needs NO extra service: it uses Supabase (run supabase/schema.sql). Upstash Redis is used instead if you set both:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# TRUSTED_PROXY_HOPS=1                # proxies in front of the app that append to X-Forwarded-For (Vercel = 1)
# HEALTH_TOKEN=                       # lets `curl -H "x-health-token: …" /api/health` return DB/email status
